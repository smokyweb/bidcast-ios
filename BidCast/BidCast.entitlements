<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      iOS parity phase 1c (2026-04-22): entitlements for APNs + FCM.
      After adding Firebase/Messaging, the app must be entitled to receive
      remote push. Xcode's "Push Notifications" capability toggle sets
      aps-environment in this file; we pre-wire it here so Codemagic can
      build without needing a manual click inside Xcode.

      TODO(phase 2+):
        - com.apple.developer.associated-domains  for universal links /
          deep linking into live shows
        - com.apple.developer.in-app-payments     if Apple Pay is routed
          through StripePaymentSheet
    -->
    <key>aps-environment</key>
    <string>development</string>

    <!--
      iOS parity phase 4m (2026-04-22): Universal Links entitlement.
      TODO-TREY: Before go-live Trey must host
        https://bidcast.betaplanets.com/.well-known/apple-app-site-association
      with an `applinks` entry for appID `YQGQU3RV34.io.bidcast` covering paths
      /stream/*, /order/*, /chat/*, /profile/*, /product/* — and enable the
      "Associated Domains" capability on the App Store provisioning profile.
      Until that file is live, https:// links will open Safari but the
      custom `bidcast://` scheme already routes via DeepLinkRouter.
    -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:bidcast.betaplanets.com</string>
    </array>
</dict>
</plist>
